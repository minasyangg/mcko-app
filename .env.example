# Образец переменных окружения. Это ЕДИНСТВЕННЫЙ файл среды в git — он не
# содержит секретов, только список того, что нужно заполнить.
#
# Локальная разработка:  скопируйте в .env.local и подставьте значения.
# Продакшен (Vercel):    те же переменные заводятся в Project Settings →
#                        Environment Variables, файл туда не кладётся.
#
# Порядок чтения у Next.js: .env.local перекрывает .env, поэтому локальные
# значения всегда побеждают. Всё, кроме этого файла, в git не попадает.

# ── Supabase ─────────────────────────────────────────────────────────────
# Ключи нового формата: sb_publishable_… и sb_secret_…
# Legacy-ключи вида eyJ… отключены на проекте 2026-07-16 и отвечают 401
# «Legacy API keys are disabled» — если что-то внезапно перестало работать,
# проверьте в первую очередь формат ключа.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Прямое подключение к Postgres, в обход PostgREST.
# Нужно для scripts/supabase-query.mjs и нагрузочного теста.
# Берётся в Project Settings → Database → Connection string → URI.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# ── Внешние сервисы ──────────────────────────────────────────────────────
# ИИ. Сейчас используется ТОЛЬКО в массовой генерации эталонных ответов;
# в PDF-импорте и проверке развёрнутых ответов отключён.
DEEPSEEK_API_KEY=sk-...

# Распознавание PDF при импорте тестов (PaddleOCR AI Studio).
# Без него PDF-ветка импорта вернёт ошибку; JSON-импорт продолжит работать.
PADDLE_OCR_TOKEN=your-paddleocr-token

# ── Доска (внешний сервис) ───────────────────────────────────────────────
# Боевой адрес доски зашит в коде (app/api/doska/open). Переменную слушаем
# только когда она указывает на localhost — для локальной разработки доски.
DOSKA_URL=http://localhost:8080
# Общий секрет для серверного обмена одноразовым тикетом. То же значение
# должно стоять на стороне доски. Без него переход отдаёт «not-configured».
DOSKA_SSO_SECRET=your-shared-secret

# ── Telegram-уведомления ─────────────────────────────────────────────────
# Опционально: без токена уведомления просто не отправляются, остальное
# приложение работает как обычно.
TELEGRAM_BOT_TOKEN=
# Секрет вебхука: им подписан входящий запрос от Telegram, роут отвергает
# всё остальное. Задаётся при установке вебхука (app/api/telegram/setup).
TELEGRAM_WEBHOOK_SECRET=

# ── Служебное ────────────────────────────────────────────────────────────
# Только для локальных вызовов Vercel API (логи, деплой). В продакшене не нужен.
VERCEL_API_KEY=

# ── Запасные имена (в этот файл не нужны) ────────────────────────────────
# Часть служебных скриптов принимает те же значения под другими именами,
# передаваемыми прямо в командной строке:
#   scripts/supabase-query.mjs   — DATABASE_URL / POSTGRES_URL как замена SUPABASE_DB_URL
#   scripts/seed-students.mjs    — SUPABASE_URL / SERVICE_ROLE_KEY
#   scripts/migrate-solution-media.mjs, book-import.mjs — то же
# Пример: SUPABASE_URL="..." SERVICE_ROLE_KEY="..." node scripts/seed-students.mjs
