NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Прямое подключение Postgres (scripts/supabase-query.mjs) — Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres
# Публичный адрес доски (doska): по нему /api/doska/open делает серверный вызов
# за одноразовым тикетом и туда же уводит браузер учителя или ученика.
DOSKA_URL=http://localhost:8080
# Общий секрет с доской: им подписан серверный запрос за тикетом, чтобы
# hashed_token не пришлось класть в адресную строку. То же значение должно
# лежать в DOSKA_SSO_SECRET на стороне доски.
DOSKA_SSO_SECRET=
PADDLE_OCR_TOKEN=your-paddleocr-token
