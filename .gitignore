# Файлы среды: в git попадает ТОЛЬКО .env.example (в нём одни плейсхолдеры).
# Правило «всё .env* кроме образца» — чтобы новый файл со ключами не утёк
# по недосмотру, как это уже случалось с .env.development.local.example.
.env*
!.env.example
out/
build/
.claude/*
!.claude/skills/
.vscode/

# Supabase local dev
supabase/.branches
supabase/.temp
supabase/functions/.tmp

# OCR-сканы книг (авторские материалы — не публиковать в репозитории)
*_by_PaddleOCR*.json
algebra_*.json
book-import-sql/

# Локальный архив: образцы OCR, документы ФИПИ, устаревшая документация v1.
# Не под контролем версий — это рабочие материалы, а не часть проекта.
/_local/

# Артефакт инкрементальной сборки TypeScript
tsconfig.tsbuildinfo

# Windows-устройство, а не файл: появляется от ошибочных перенаправлений
# вида `cmd > nul` и ломает git add
nul
