# Локальный Supabase (Docker) — только при npm run dev
# Скопируй этот файл в .env.development.local и подставь ключи из: npx supabase status

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key из npx supabase status>
SUPABASE_SERVICE_ROLE_KEY=<service_role key из npx supabase status>
DEEPSEEK_API_KEY=your-deepseek-key
